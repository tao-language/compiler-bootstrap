extern @int_sub(Int, Int) -> Int
extern @int_mul(Int, Int) -> Int
extern @int_add(Int, Int) -> Int
extern @float_add(Float, Float) -> Float
extern @float_sub(Float, Float) -> Float
extern @float_mul(Float, Float) -> Float

fn (+) {
| @int_add(Int, Int)
| @float_add(Float, Float)
}

>>> 3 + 2       5
>>> 3.0 + 2.0   5.0

fn (-) {
| @int_sub(Int, Int)
| @float_sub(Float, Float)
}

>>> 3 - 2       1
>>> 3.0 - 2.0   1.0

fn (*) {
| @int_mul(Int, Int)
| @float_mul(Float, Float)
}

>>> 3 * 2       6
>>> 3.0 * 2.0   6.0
