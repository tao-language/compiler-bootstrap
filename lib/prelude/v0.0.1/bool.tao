type Bool {
| True
| False
}

fn _and(x: Bool, y: Bool) -> Bool
= match x, y {
| True, True => True
| _, _ => False
}

>>> _and(True,  True)   True
>>> _and(True,  False)  False
>>> _and(False, True)   False
>>> _and(False, False)  False

fn _or(x: Bool, y: Bool) -> Bool
= match x, y {
| False, False => False
| _, _ => True
}

>>> _or(True,  True)  True
>>> _or(True,  False) True
>>> _or(False, True)  True
>>> _or(False, False) False
